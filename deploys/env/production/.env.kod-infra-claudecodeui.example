# kodemeio-claudecodeui — Production (kod)  [server: kod-prod-03-data]
# Copy to .env.kod-infra-claudecodeui (gitignored). NO secrets here:
# subscription logins are provisioned AFTER deploy via the app's built-in
# terminal (`claude login` / `codex login`); state persists in named volumes.

COMPOSE_PROJECT_NAME=kod-infra-claudecodeui
DOMAIN=claudecodeui.kodeme.io

# --- app server ---
SERVER_PORT=3001
HOST=0.0.0.0
DATABASE_PATH=/data/auth.db
CONTEXT_WINDOW=160000
VITE_CONTEXT_WINDOW=160000
TZ=Asia/Jakarta

# --- image: prebuilt, pulled from public GHCR. Pin to a CI tag (sha-xxxx or a
#     vX.Y.Z release); avoid 'latest' in prod. Updated after the CI build. ---
IMAGE_TAG=main

# --- resource limits ---
CPU_LIMIT=1.5
MEM_LIMIT=1536M
