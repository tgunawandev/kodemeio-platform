# =============================================================================
# Terraform Variables - Kodemeio Hetzner Infrastructure
# =============================================================================
# Copy to terraform.tfvars and fill in values:
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

hcloud_token    = "your-hetzner-cloud-api-token"
environment     = "prod"
location        = "fsn1"
resource_prefix = "kodemeio"
domain          = "kodeme.io"
timezone        = "Asia/Jakarta"
swap_size_mb    = 4096
ssh_port        = 22

# =============================================================================
# SSH Keys
# =============================================================================

ssh_keys = {
  admin = {
    public_key = "ssh-ed25519 AAAAC3... admin@kodeme.io"
  }
  deploy = {
    public_key = "ssh-ed25519 AAAAC3... deploy@kodeme.io"
  }
}

# =============================================================================
# Networks
# =============================================================================
# Private network for inter-server communication (database, redis, etc.)
# All servers on the same private network can communicate without public IPs.

networks = {
  main = {
    ip_range = "10.0.0.0/16"
    subnets = [
      {
        ip_range     = "10.0.1.0/24"
        type         = "cloud"
        network_zone = "eu-central"
      }
    ]
  }
}

# =============================================================================
# Firewalls
# =============================================================================

firewalls = {
  # Dokploy/App server - accepts web traffic
  web = {
    labels = { role = "web" }
    rules = [
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "22"
        description = "SSH"
        source_ips  = ["0.0.0.0/0", "::/0"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "80"
        description = "HTTP"
        source_ips  = ["0.0.0.0/0", "::/0"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "443"
        description = "HTTPS"
        source_ips  = ["0.0.0.0/0", "::/0"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "3000"
        description = "Dokploy UI"
        source_ips  = ["0.0.0.0/0", "::/0"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "25"
        description = "SMTP"
        source_ips  = ["0.0.0.0/0", "::/0"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "587"
        description = "SMTP submission"
        source_ips  = ["0.0.0.0/0", "::/0"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "993"
        description = "IMAPS"
        source_ips  = ["0.0.0.0/0", "::/0"]
      }
    ]
  }

  # Database server - only private network + SSH
  database = {
    labels = { role = "database" }
    rules = [
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "22"
        description = "SSH"
        source_ips  = ["0.0.0.0/0", "::/0"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "5432"
        description = "PostgreSQL (private network only)"
        source_ips  = ["10.0.0.0/16"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "6432"
        description = "PgBouncer (private network only)"
        source_ips  = ["10.0.0.0/16"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "6379"
        description = "Redis (private network only)"
        source_ips  = ["10.0.0.0/16"]
      },
      {
        direction   = "in"
        protocol    = "tcp"
        port        = "9187"
        description = "Postgres exporter (private network only)"
        source_ips  = ["10.0.0.0/16"]
      }
    ]
  }
}

# =============================================================================
# Servers
# =============================================================================
#
# Architecture Options (choose one):
#
# OPTION A - Single Server (simplest, cheapest)
#   Everything on one cx42/cx52 server via Dokploy.
#   Good for: early stage, <50 concurrent users
#   Cost: ~€35-65/mo
#
# OPTION B - 2-Server Split (recommended)
#   Server 1: App server (Dokploy + all containers)
#   Server 2: Database (PostgreSQL + Redis + PgBouncer)
#   Good for: production, up to ~500 concurrent users
#   Cost: ~€55-100/mo
#
# OPTION C - 3-Server Split (scale-ready)
#   Server 1: Web/Frontend (React SPAs, Next.js, Traefik)
#   Server 2: API/Backend (FastAPI, workers, agents, Odoo)
#   Server 3: Database (PostgreSQL + Redis)
#   Good for: production, 500+ concurrent users
#   Cost: ~€85-150/mo
#
# Below: OPTION B (recommended for Kodemeio)
# =============================================================================

servers = {
  # App server - runs Dokploy with all application containers
  # Services: Traefik, React SPAs (8), Next.js (3), FastAPI (13),
  #           Odoo 18, Authentik, Plane, Grafana, Gatus, Mailcow,
  #           Outline, Zulip, Telegram bot, OpenClaw AI, RustDesk, RMM
  dokploy = {
    server_type     = "cx42"          # 8 vCPU, 16 GB RAM, 160 GB disk
    image           = "ubuntu-24.04"
    location        = "fsn1"
    ssh_keys        = ["admin", "deploy"]
    firewall_ids    = ["web"]
    network         = "main"
    backups         = true
    delete_protection = true
    labels = {
      role    = "app"
      service = "dokploy"
      fqdn    = "dokploy.kodeme.io"
    }
    volumes = [
      { name = "dokploy-data", size = 80 }    # Docker volumes, Traefik certs, app data
    ]
  }

  # Database server - dedicated PostgreSQL + Redis
  # Services: PostgreSQL 16, PgBouncer, Redis 7, postgres-exporter
  # Databases: plane, authentik, glitchtip, outline, telegram, zulip, gatus, kodemeio_python
  db = {
    server_type     = "cx32"          # 4 vCPU, 8 GB RAM, 80 GB disk
    image           = "ubuntu-24.04"
    location        = "fsn1"
    ssh_keys        = ["admin", "deploy"]
    firewall_ids    = ["database"]
    network         = "main"
    backups         = true
    delete_protection = true
    labels = {
      role    = "database"
      service = "postgres"
      fqdn    = "db.kodeme.io"
    }
    volumes = [
      { name = "pg-data", size = 100 }        # PostgreSQL data
      { name = "pg-backup", size = 50 }        # Local backups before S3
    ]
  }
}

# =============================================================================
# Load Balancers (optional - for multi-server web tier)
# =============================================================================
# Uncomment if using Option C or need HA

