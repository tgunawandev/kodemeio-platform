# ak-sync — Automated User Provisioning Service
# Copy to .env.kod-infra-ak-sync and fill in secrets

# Server
NODE_ENV=production
PORT=3030
TZ=Asia/Jakarta

# Webhook auth (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=
ODOO_WEBHOOK_HMAC_KEY=

# kctl-ak connection (Authentik)
KCTL_AK_TOKEN=
KCTL_AK_URL=https://auth.kodeme.io

# Mailcow
MAILCOW_API_KEY=

# Odoo targets — MAC
ODOO_MAC_ODOO_DIST_MANDIRIAGRO_COM_DB=
ODOO_MAC_ODOO_DIST_MANDIRIAGRO_COM_KEY=

# Odoo targets — TPP
ODOO_TPP_ODOO_TRAD_PAKERTI_COM_DB=
ODOO_TPP_ODOO_TRAD_PAKERTI_COM_KEY=

# Odoo targets — KOD
ODOO_KOD_ODOO_FULL_KODEME_IO_DB=
ODOO_KOD_ODOO_FULL_KODEME_IO_KEY=

# Provision config path (mounted volume)
PROVISION_CONFIG=/app/config/provision-config.yaml
