# xyOps conductor (tpp-infra-xyops) on tpp-prod-04.
#
# XYOPS_SECRET_KEY is the vault encryption key. Losing it makes every stored
# secret permanently unrecoverable — a restored data volume is worthless
# without it. Generate ONCE with `openssl rand -hex 32` and store in 1Password.
XYOPS_HOSTNAME=tpp-prod-04.internal
XYOPS_BASE_APP_URL=https://xyops.idtpp.com
XYOPS_SECRET_KEY=__SET_IN_DOKPLOY__
TZ=Asia/Jakarta

# Emergency admin, consumed on startup. Remove once a permanent user exists,
# or xyOps recreates the account on every restart.
XYOPS_RECOVER_ADMIN=username:__SET_IN_DOKPLOY__

# Outbound mail. Without these, failure actions die with ECONNREFUSED against
# localhost:25 and alerts are silently never delivered.
XYOPS_EMAIL_FROM=reports@idtpp.com
SMTP_HOST=mail.idtpp.com
SMTP_PORT=587
SMTP_USER=reports@idtpp.com
SMTP_PASS=__SET_IN_DOKPLOY__
