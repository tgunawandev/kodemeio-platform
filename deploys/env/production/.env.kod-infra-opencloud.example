# =============================================================================
# OpenCloud + Collabora — kodemeio PRODUCTION
# =============================================================================
# Copy to .env.kod-infra-opencloud and fill in CHANGE_ME values
# Generate secrets: openssl rand -base64 45

# Compose Project
COMPOSE_PROJECT_NAME=kodemeio-opencloud
TENANT=kodemeio

# Domain
OC_DOMAIN=cloud.kodeme.io
OC_URL=https://cloud.kodeme.io
COLLABORA_DOMAIN=collabora.kodeme.io

# OpenCloud Version
OPENCLOUD_TAG=6.0.0

# Secrets (REQUIRED — openssl rand -base64 45)
OC_JWT_SECRET=CHANGE_ME_JWT_SECRET
OC_TRANSFER_SECRET=CHANGE_ME_TRANSFER_SECRET
OC_MACHINE_AUTH_API_KEY=CHANGE_ME_MACHINE_AUTH_KEY
OC_SYSTEM_USER_API_KEY=CHANGE_ME_SYSTEM_USER_KEY

# Authentik OIDC
OC_OIDC_ISSUER=https://auth.kodeme.io/application/o/opencloud/
WEB_OIDC_CLIENT_ID=opencloud
PROXY_OIDC_CLIENT_ID=opencloud
PROXY_OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
OC_EXCLUDE_RUN_SERVICES=idp,idm
PROXY_AUTOPROVISION_ACCOUNTS=true
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_OIDC_REWRITE_WELLKNOWN=true
WEB_OIDC_SCOPE=openid profile email groups

# S3 Storage (Hetzner Object Storage)
DECOMPOSEDS3_ENDPOINT=https://fsn1.your-objectstorage.com
DECOMPOSEDS3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
DECOMPOSEDS3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
DECOMPOSEDS3_BUCKET=kodemeio-opencloud-data
DECOMPOSEDS3_REGION=fsn1

# Collabora Online
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=CHANGE_ME_COLLABORA_ADMIN
COLLABORA_ALIASGROUP=https://cloud.kodeme.io:443
COLLABORA_SERVER_NAME=collabora.kodeme.io

# SMTP
SMTP_HOST=mail.kodeme.io
SMTP_PORT=587
SMTP_SENDER=system@kodeme.io
SMTP_USERNAME=system@kodeme.io
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_TRANSPORT_ENCRYPTION=starttls

# Resource Limits
OC_CPU_LIMIT=2.0
OC_MEMORY_LIMIT=2G
COLLABORA_CPU_LIMIT=1.5
COLLABORA_MEMORY_LIMIT=2G

# Timezone
TZ=Asia/Jakarta
