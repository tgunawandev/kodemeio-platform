# =============================================================================
# Outline Wiki — TPP (Pakerti) PRODUCTION — EXAMPLE
# Service: tpp-infra-outline | Server: tpp-prod-01 | Domain: outline.idtpp.com
# =============================================================================
# Copy to .env.tpp-infra-outline and fill in the CHANGEME-* placeholders.
# Sanitized template — safe to commit.
# =============================================================================

# =============================================================================
# COMPOSE
# =============================================================================
COMPOSE_PROJECT_NAME=tpp-infra-outline
OUTLINE_VERSION=0.82.0
OUTLINE_PORT=3000
TZ=Asia/Jakarta

# =============================================================================
# OUTLINE — Core
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================
SECRET_KEY=CHANGEME-SECRET-KEY
UTILS_SECRET=CHANGEME-UTILS-SECRET
NODE_ENV=production
FORCE_HTTPS=true
ENABLE_UPDATES=true
LOG_LEVEL=info
DEFAULT_LANGUAGE=en_US
URL=https://outline.idtpp.com
PORT=3000
ALLOWED_DOMAINS=idtpp.com

# =============================================================================
# DATABASE — tpp-infra-postgres (Hetzner private network 10.0.0.2)
# Provision: kctl-pg db create outline --owner outline --password <pw>
# =============================================================================
DATABASE_URL=postgres://outline:CHANGEME-DB-PASSWORD@10.0.0.2:5432/outline?sslmode=disable
DATABASE_CONNECTION_POOL_MIN=2
DATABASE_CONNECTION_POOL_MAX=20

# =============================================================================
# REDIS — Dedicated Redis 7 (service name: outline-redis inside compose)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# =============================================================================
REDIS_PASSWORD=CHANGEME-REDIS-PASSWORD
REDIS_URL=redis://:CHANGEME-REDIS-PASSWORD@outline-redis:6379

# =============================================================================
# S3 / OBJECT STORAGE — Hetzner Object Storage (tpp-outline bucket)
# Provision: kctl-hz object-storage create-bucket tpp-outline --region fsn1
# CORS: allow https://outline.idtpp.com
# =============================================================================
AWS_ACCESS_KEY_ID=CHANGEME-S3-ACCESS-KEY
AWS_SECRET_ACCESS_KEY=CHANGEME-S3-SECRET-KEY
AWS_REGION=fsn1
AWS_S3_UPLOAD_BUCKET_URL=https://fsn1.your-objectstorage.com
AWS_S3_UPLOAD_BUCKET_NAME=tpp-outline
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private
AWS_S3_UPLOAD_MAX_SIZE=26214400

# =============================================================================
# AUTHENTIK — OIDC Single Sign-On (tpp-infra-authentik @ auth.idtpp.com)
# Provision: kctl-ak provider oauth2 create --slug outline \
#   --redirect-uri https://outline.idtpp.com/auth/oidc.callback \
#   --scopes "openid profile email"
# =============================================================================
OIDC_CLIENT_ID=CHANGEME-OIDC-CLIENT-ID
OIDC_CLIENT_SECRET=CHANGEME-OIDC-CLIENT-SECRET
OIDC_AUTH_URI=https://auth.idtpp.com/application/o/authorize/
OIDC_TOKEN_URI=https://auth.idtpp.com/application/o/token/
OIDC_USERINFO_URI=https://auth.idtpp.com/application/o/userinfo/
OIDC_LOGOUT_URI=https://auth.idtpp.com/application/o/outline/end-session/
OIDC_DISPLAY_NAME=Pakerti SSO
OIDC_SCOPES=openid profile email

# =============================================================================
# SMTP — tpp-infra-mailcow @ mail.idtpp.com
# Provision: kctl-mailcow mailbox create outline@idtpp.com --password <pw>
# =============================================================================
SMTP_HOST=mail.idtpp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=outline@idtpp.com
SMTP_PASSWORD=CHANGEME-SMTP-PASSWORD
SMTP_FROM_EMAIL=outline@idtpp.com
SMTP_REPLY_EMAIL=outline@idtpp.com
SMTP_TLS_CIPHERS=TLSv1.2

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60

# =============================================================================
# GLITCHTIP — Error Tracking (optional)
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# =============================================================================
# KCTL-OUTLINE — CLI Admin Token (generate from Outline UI after first login)
# =============================================================================
OUTLINE_API_TOKEN=
