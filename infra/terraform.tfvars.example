# =============================================================================
# kodemeio-dokploy — Terraform Variables Example
# =============================================================================
# Copy this file to terraform.tfvars and fill in real values.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit terraform.tfvars — it contains secrets.
# Store actual values in 1Password and export with:
#   eval $(kctl-op env export kodemeio-terraform)
# =============================================================================

# =============================================================================
# Shared
# =============================================================================

environment = "prod"

# =============================================================================
# Cloudflare Credentials
# =============================================================================
# Minimum token permissions:
#   Zone:Zone:Read, Zone:DNS:Edit, Zone:Firewall Services:Edit,
#   Zone:SSL and Certificates:Edit, Zone:Cache Rules:Edit,
#   Zone:Page Rules:Edit, Account:Workers Scripts:Edit,
#   Account:Account Settings:Read

cloudflare_api_token    = "your-cloudflare-api-token"
cloudflare_account_name = "your-account-name"

# =============================================================================
# Hetzner Cloud Credentials
# =============================================================================
# Create a read/write API token at: https://console.hetzner.cloud/projects

hcloud_token = "your-hetzner-cloud-api-token"

# =============================================================================
# Hetzner — Server Defaults
# =============================================================================

location        = "fsn1"          # fsn1 | nbg1 | hel1 | ash | hil
resource_prefix = "kodemeio"
domain          = "kodeme.io"
timezone        = "Asia/Jakarta"
swap_size_mb    = 4096
ssh_port        = 22

# =============================================================================
# SSH Keys
# =============================================================================

ssh_keys = {
  admin = {
    public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... admin@kodeme.io"
  }
  deploy = {
    public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... deploy@kodeme.io"
  }
}

# =============================================================================
# Networks
# =============================================================================

networks = {
  main = {
    ip_range = "10.0.0.0/16"
    subnets = [
      {
        ip_range     = "10.0.1.0/24"
        type         = "cloud"
        network_zone = "eu-central"
      }
    ]
  }
}

# =============================================================================
# Hetzner Firewalls
# =============================================================================

firewalls = {
  web = {
    labels = { role = "web" }
    rules = [
      { direction = "in", protocol = "tcp", port = "22",   description = "SSH",           source_ips = ["0.0.0.0/0", "::/0"] },
      { direction = "in", protocol = "tcp", port = "80",   description = "HTTP",          source_ips = ["0.0.0.0/0", "::/0"] },
      { direction = "in", protocol = "tcp", port = "443",  description = "HTTPS",         source_ips = ["0.0.0.0/0", "::/0"] },
      { direction = "in", protocol = "tcp", port = "3000", description = "Dokploy UI",    source_ips = ["0.0.0.0/0", "::/0"] },
      { direction = "in", protocol = "tcp", port = "25",   description = "SMTP",          source_ips = ["0.0.0.0/0", "::/0"] },
      { direction = "in", protocol = "tcp", port = "587",  description = "SMTP submit",   source_ips = ["0.0.0.0/0", "::/0"] },
      { direction = "in", protocol = "tcp", port = "993",  description = "IMAPS",         source_ips = ["0.0.0.0/0", "::/0"] }
    ]
  }

  database = {
    labels = { role = "database" }
    rules = [
      { direction = "in", protocol = "tcp", port = "22",   description = "SSH",                              source_ips = ["0.0.0.0/0", "::/0"] },
      { direction = "in", protocol = "tcp", port = "5432", description = "PostgreSQL (private network only)", source_ips = ["10.0.0.0/16"] },
      { direction = "in", protocol = "tcp", port = "6432", description = "PgBouncer (private network only)",  source_ips = ["10.0.0.0/16"] },
      { direction = "in", protocol = "tcp", port = "6379", description = "Redis (private network only)",      source_ips = ["10.0.0.0/16"] }
    ]
  }
}

# =============================================================================
# Hetzner Servers
# =============================================================================
# See the Hetzner module's terraform.tfvars.example for cost/architecture notes.

servers = {
  dokploy = {
    server_type       = "cx42"          # 8 vCPU / 16 GB / 160 GB — ~€28/mo
    image             = "ubuntu-24.04"
    location          = "fsn1"
    ssh_keys          = ["admin", "deploy"]
    firewall_ids      = ["web"]
    network           = "main"
    backups           = true
    delete_protection = true
    labels = {
      role    = "app"
      service = "dokploy"
      fqdn    = "dokploy.kodeme.io"
    }
    volumes = [
      { name = "dokploy-data", size = 80 }
    ]
  }

  db = {
    server_type       = "cx32"          # 4 vCPU / 8 GB / 80 GB — ~€14/mo
    image             = "ubuntu-24.04"
    location          = "fsn1"
    ssh_keys          = ["admin", "deploy"]
    firewall_ids      = ["database"]
    network           = "main"
    backups           = true
    delete_protection = true
    labels = {
      role    = "database"
      service = "postgres"
      fqdn    = "db.kodeme.io"
    }
    volumes = [
      { name = "pg-data",   size = 100 },
      { name = "pg-backup", size = 50 }
    ]
  }
}

# =============================================================================
# Hetzner Placement Groups
# =============================================================================

placement_groups = {
  main = {
    type   = "spread"
    labels = { role = "production" }
  }
}

load_balancers = {}

# =============================================================================
# Cloudflare Zones
# =============================================================================

zones = {
  "kodeme.io" = { plan = "free" }
  # "terakidz.com"    = { plan = "free" }
  # "mandiriagro.com" = { plan = "free" }
  # "pakerti.com"     = { plan = "free" }
  # "trigunawan.com"  = { plan = "free" }
  # "kidneuro.io"     = { plan = "free" }
  # "provetics.com"   = { plan = "free" }
}

# =============================================================================
# Cloudflare DNS Records
# =============================================================================

dns_records = {
  "kodeme-io-root" = {
    zone_name = "kodeme.io"
    name      = "@"
    type      = "A"
    value     = "192.0.2.1"    # Replace with actual server IP after apply
    proxied   = true
    comment   = "Root domain — Dokploy server"
  }

  "kodeme-io-www" = {
    zone_name = "kodeme.io"
    name      = "www"
    type      = "CNAME"
    value     = "kodeme.io"
    proxied   = true
    comment   = "WWW redirect"
  }

  "kodeme-io-mx1" = {
    zone_name = "kodeme.io"
    name      = "@"
    type      = "MX"
    value     = "route1.mx.cloudflare.net"
    priority  = 28
    proxied   = false
    comment   = "Cloudflare email routing"
  }

  "kodeme-io-mx2" = {
    zone_name = "kodeme.io"
    name      = "@"
    type      = "MX"
    value     = "route2.mx.cloudflare.net"
    priority  = 11
    proxied   = false
    comment   = "Cloudflare email routing"
  }

  "kodeme-io-spf" = {
    zone_name = "kodeme.io"
    name      = "@"
    type      = "TXT"
    value     = "v=spf1 include:_spf.mx.cloudflare.net ~all"
    proxied   = false
    comment   = "SPF"
  }

  "kodeme-io-dmarc" = {
    zone_name = "kodeme.io"
    name      = "_dmarc"
    type      = "TXT"
    value     = "v=DMARC1; p=quarantine; rua=mailto:admin@kodeme.io"
    proxied   = false
    comment   = "DMARC"
  }
}

