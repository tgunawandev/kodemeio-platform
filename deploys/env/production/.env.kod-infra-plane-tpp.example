# =============================================================================
# Plane - TPP PRODUCTION (plane.idtpp.com) — TEMPLATE (no secrets)
# =============================================================================
# Server: kod-prod-05-app — kodeme infra serving TPP brand
# Domain: plane.idtpp.com
# Postgres: bundled in compose (COMPOSE_PROFILES=bundled-db)
# OIDC: auth.idtpp.com (TPP Authentik)
#
# Generate fresh secrets with:
#   SECRET_KEY              openssl rand -hex 32
#   LIVE_SERVER_SECRET_KEY  openssl rand -hex 32
#   POSTGRES_PASSWORD       openssl rand -hex 24
#   RABBITMQ_DEFAULT_PASS   openssl rand -hex 16
#   ZULIP_WEBHOOK_TOKEN     openssl rand -hex 16
#   GITHUB_WEBHOOK_SECRET   openssl rand -hex 16
# =============================================================================

# Compose Project
COMPOSE_PROJECT_NAME=kod-infra-plane-tpp
COMPOSE_PROFILES=bundled-db
TENANT=tpp

# GitHub Container Registry
GITHUB_REPOSITORY_OWNER=tgunawandev

# Domain
Domain=plane.idtpp.com
WEB_URL=https://plane.idtpp.com
CORS_ALLOWED_ORIGINS=https://plane.idtpp.com

# Version
APP_RELEASE=v1.2.3

# PostgreSQL (Bundled)
PGHOST=postgres
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=<generate-openssl-rand-hex-24>
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:<POSTGRES_PASSWORD>@postgres:5432/plane

# Redis (Bundled)
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ (Bundled)
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=plane
RABBITMQ_DEFAULT_PASS=<generate-openssl-rand-hex-16>
RABBITMQ_DEFAULT_VHOST=plane
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:<RABBITMQ_DEFAULT_PASS>@plane-mq:5672/plane

# S3 Storage (Hetzner Object Storage — separate bucket for TPP)
USE_MINIO=0
AWS_REGION=fsn1
AWS_ACCESS_KEY_ID=<hetzner-s3-access-key>
AWS_SECRET_ACCESS_KEY=<hetzner-s3-secret-key>
AWS_S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
AWS_S3_BUCKET_NAME=kodemeio-plane-tpp
BUCKET_NAME=kodemeio-plane-tpp
MINIO_ENDPOINT_SSL=1
FILE_SIZE_LIMIT=5242880

# Proxy
NGINX_PORT=80

# Security
SECRET_KEY=<generate-openssl-rand-hex-32>
LIVE_SERVER_SECRET_KEY=<generate-openssl-rand-hex-32>

# API
API_BASE_URL=http://api:8000
API_KEY_RATE_LIMIT=60/minute
GUNICORN_WORKERS=1

# Debug
DEBUG=0
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Email / SMTP
EMAIL_HOST=mail.kodeme.io
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@idtpp.com
EMAIL_HOST_PASSWORD=<set-smtp-password>
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_FROM=noreply@idtpp.com

# Native OIDC (auth.idtpp.com)
AUTHENTIK_URL=https://auth.idtpp.com
OIDC_AUTO=1
OIDC_CLIENT_ID=<from-authentik-plane-oauth-provider>
OIDC_CLIENT_SECRET=<from-authentik-plane-oauth-provider>
OIDC_DISCOVERY=https://auth.idtpp.com/application/o/plane-oauth/
OIDC_PROVIDER_NAME=Authentik
OIDC_DEFAULT_WORKSPACE=tpp

# Zulip Integration (optional — leave empty to disable)
ZULIP_URL=
ZULIP_BOT_EMAIL=
ZULIP_BOT_API_KEY=
ZULIP_STREAM=
ZULIP_TOPIC=
ZULIP_WEBHOOK_TOKEN=<generate-openssl-rand-hex-16>
PLANE_URL=https://plane.idtpp.com
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=tpp
CREDENTIALS_SECRET=
WEBHOOK_NOTIFICATIONS=0

# Google Calendar Integration (optional)
GCAL_SERVICE_ACCOUNT_KEY_FILE=/app/data/service-account.json
# GCAL_EMAIL_DOMAIN=idtpp.com

# GitHub Integration (optional)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=<generate-openssl-rand-hex-16>
GITHUB_DEFAULT_OWNER=
GITHUB_PLANE_PROJECT_MAP=

# Google Sheets Integration (optional)
GSHEET_SPREADSHEET_ID=

# Timezone
TZ=Asia/Jakarta
