# kod-infra-mcp-gateway — sanitized contract. Real secrets live in the
# gitignored sibling .env.kod-infra-mcp-gateway (operator-managed).

# Connection auth — consumers send `Authorization: Bearer <token>`.
# Generate: openssl rand -hex 32
MCP_GATEWAY_AUTH_TOKEN=change-me-long-random
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=8080
MCP_GATEWAY_LOG_LEVEL=info

# P1: proxy n8n only. Tools surface namespaced as n8n_<tool>.
# Point `url` at the n8n MCP Server Trigger production endpoint, reachable over
# dokploy-network internal DNS. Add an Authorization header here if the n8n MCP
# endpoint requires one (the gateway forwards backend headers per mcpServers entry).
MCP_BACKENDS={"n8n":{"url":"http://CHANGEME-n8n-host:5678/mcp/<workflow-path>","transport":"http"}}
