# =============================================================================
# tpp-infra-bentopdf — TPP PRODUCTION
# =============================================================================
# BentoPDF is a client-side SPA (nginx serving static JS/WASM). No DB, no Redis,
# no secrets. SSO is enforced by the Traefik `authentik@file` forward-auth
# middleware — attach it in Dokploy after first deploy.
#
# Copy to .env.tpp-infra-bentopdf (drop the .example suffix) before `generate.py`
# runs the deploy pipeline.

# =============================================================================
# Compose
# =============================================================================
COMPOSE_PROJECT_NAME=tpp-infra-bentopdf
TENANT=tpp

# =============================================================================
# Domain
# =============================================================================
DOMAIN=pdf.idtpp.com

# =============================================================================
# Image — pin to a specific tag/digest for production
# =============================================================================
BENTOPDF_TAG=latest

# =============================================================================
# Runtime Configuration
# =============================================================================
PORT=8080

# Hide marketing landing page — internal SSO-gated deployment.
SIMPLE_MODE=true

# Comma-separated tool IDs to disable. Blank = show all.
DISABLE_TOOLS=

# Default UI language.
DEFAULT_LANGUAGE=en

# Subdirectory deployment path (blank = root).
BASE_URL=

# Non-root UID/GID inside the container.
PUID=1000
PGID=1000

# =============================================================================
# Resource Limits
# =============================================================================
BENTOPDF_CPU_LIMIT=0.5
BENTOPDF_MEMORY_LIMIT=256M

# =============================================================================
# Authentik SSO (forward-auth)
# =============================================================================
# Traefik calls this host's /outpost.goauthentik.io/auth/traefik on every
# request to pdf.idtpp.com. Must match the Authentik instance where the
# 'bentopdf' Proxy Provider is bound to the Embedded Outpost.
# Use internal dokploy-network alias when colocated on the same host as the
# Authentik compose (tpp-infra-authentik publishes alias `authentik-server`).
# Falls back to the public URL if run on a different host.
AUTHENTIK_HOST=http://authentik-server:9000

# =============================================================================
# Timezone
# =============================================================================
TZ=Asia/Jakarta
