# =============================================================================
# Plane Project Management - kodemeio PRODUCTION
# =============================================================================
# Deployed via Dokploy Docker Compose project.
# All variables are loaded by Dokploy as environment for docker-compose.prod.yml.
# =============================================================================

# Deployment Identity
DEPLOY_ENV=production

# GitHub Container Registry (for pulling OIDC images)
GITHUB_REPOSITORY_OWNER=tgunawandev

# Domain
Domain=plane.kodeme.io
WEB_URL=https://plane.kodeme.io

# Version
APP_RELEASE=v1.2.3

# Django
SECRET_KEY=<generate-openssl-rand-hex-32>

# PostgreSQL (External — kodemeio-postgres-16)
PGHOST=10.0.0.3
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:<password>@10.0.0.3/plane

# Redis
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=plane
RABBITMQ_DEFAULT_PASS=<generate>
RABBITMQ_DEFAULT_VHOST=plane
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:<password>@plane-mq:5672/plane

# S3 Storage (Hetzner Object Storage)
USE_MINIO=0
AWS_REGION=fsn1
AWS_ACCESS_KEY_ID=<hetzner-s3-access-key>
AWS_SECRET_ACCESS_KEY=<hetzner-s3-secret-key>
AWS_S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
AWS_S3_BUCKET_NAME=kodemeio-plane
BUCKET_NAME=kodemeio-plane
MINIO_ENDPOINT_SSL=1

# OIDC (Authentik SSO)
OIDC_AUTO=1
OIDC_CLIENT_ID=<from-authentik>
OIDC_CLIENT_SECRET=<from-authentik>
OIDC_DISCOVERY=https://auth.kodeme.io/application/o/plane-oauth/
OIDC_PROVIDER_NAME=Authentik
OIDC_DEFAULT_WORKSPACE=kodemeio

# Zulip Integration
ZULIP_URL=https://zulip.kodeme.io
ZULIP_BOT_EMAIL=<bot-email>
ZULIP_BOT_API_KEY=<bot-api-key>
ZULIP_STREAM=plane-notifications
ZULIP_TOPIC=updates
ZULIP_WEBHOOK_TOKEN=<generate>
PLANE_API_KEY=<create-post-deploy>
PLANE_WORKSPACE_SLUG=kodemeio

# Google Calendar Integration
GCAL_SERVICE_ACCOUNT_KEY_FILE=/app/data/service-account.json

# GitHub Integration
GITHUB_TOKEN=<github-pat-repo-scope>
GITHUB_WEBHOOK_SECRET=<generate>
GITHUB_DEFAULT_OWNER=tgunawandev
GITHUB_PLANE_PROJECT_MAP=owner/repo:PROJ

# Google Sheets Integration
GSHEET_SPREADSHEET_ID=<spreadsheet-id-from-url>
GSHEET_SHEET_NAME=Plane Issues
