# kodemeio-cloudflare Terraform Variables
# Copy to terraform.tfvars and fill in values

cloudflare_api_token    = "your-cloudflare-api-token"
cloudflare_account_name = "your-account-name"
environment             = "prod"

# ─── Zones ────────────────────────────────────────────────────────────────────

zones = {
  "kodeme.io" = {
    plan = "free"
  }
}

# ─── DNS Records ──────────────────────────────────────────────────────────────

dns_records = {
  # Root domain
  "kodeme-io-root" = {
    zone_name = "kodeme.io"
    name      = "@"
    type      = "A"
    value     = "192.0.2.1"
    proxied   = true
    comment   = "Root domain"
  }

  # WWW redirect
  "kodeme-io-www" = {
    zone_name = "kodeme.io"
    name      = "www"
    type      = "CNAME"
    value     = "kodeme.io"
    proxied   = true
    comment   = "WWW redirect"
  }

  # Mail records
  "kodeme-io-mx1" = {
    zone_name = "kodeme.io"
    name      = "@"
    type      = "MX"
    value     = "route1.mx.cloudflare.net"
    priority  = 28
    proxied   = false
    comment   = "Cloudflare email routing"
  }

  "kodeme-io-mx2" = {
    zone_name = "kodeme.io"
    name      = "@"
    type      = "MX"
    value     = "route2.mx.cloudflare.net"
    priority  = 11
    proxied   = false
    comment   = "Cloudflare email routing"
  }

  # SPF
  "kodeme-io-spf" = {
    zone_name = "kodeme.io"
    name      = "@"
    type      = "TXT"
    value     = "v=spf1 include:_spf.mx.cloudflare.net ~all"
    proxied   = false
    comment   = "SPF record"
  }

  # DMARC
  "kodeme-io-dmarc" = {
    zone_name = "kodeme.io"
    name      = "_dmarc"
    type      = "TXT"
    value     = "v=DMARC1; p=quarantine; rua=mailto:admin@kodeme.io"
    proxied   = false
    comment   = "DMARC policy"
  }
}

