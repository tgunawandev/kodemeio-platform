# =============================================================================
# kod-infra-hermes — Production Environment (example)
# =============================================================================
# Copy this file to .env.kod-infra-hermes under
# kodemeio-platform/deploys/env/production/ and replace every CHANGE_ME.
# Real values are populated in Dokploy's UI — never commit them.

# ── Hermes core ──────────────────────────────────────────────────────────────
# Pin to a real upstream release tag. Browse:
# https://github.com/NousResearch/hermes-agent/releases
HERMES_UPSTREAM_REF=v0.14.0
HERMES_LOG_LEVEL=info
TZ=Asia/Jakarta

# UID/GID inside the container. Default matches upstream's `hermes` user.
# Override only if the host volume is owned by a different UID.
HERMES_UID=10000
HERMES_GID=10000

# ── Model backend: Codex via ChatGPT Plus/Pro OAuth ──────────────────────────
# No API key needed. The OAuth token is established once via:
#   ./scripts/bootstrap-oauth.sh
# and persisted under /opt/data on the hermes-state volume.

# ── Inbound: Telegram bot (native upstream support) ──────────────────────────
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Optional: comma-separated Telegram user IDs allowed to talk to the bot.
# Leave empty to allow all (NOT recommended for a production bot).
TELEGRAM_ALLOWED_USERS=

# ── MCP server: Odoo (functional today) ──────────────────────────────────────
# kodemeio-odoo-mcp container_name is "kodemeio-odoo-mcp"; both containers
# share dokploy-network so Docker's embedded DNS resolves the name directly.
MCP_ODOO_URL=http://kodemeio-odoo-mcp:8080
# Must equal MCP_AUTH_TOKEN in kodemeio-odoo-mcp/.env.
MCP_ODOO_AUTH_TOKEN=CHANGE_ME

# ── Phase-2 MCP servers (env-wired only — MCP servers not built yet) ─────────
# Leave MCP_<SERVICE>_URL empty until the corresponding mcp-<service> sidecar
# is deployed. The render script skips inactive blocks automatically.

# Mattermost — points at the kod-tenant target you choose (currently no
# kod-infra-mattermost exists; mac-mattermost is the reachable instance).
MATTERMOST_BASE_URL=https://mac-mattermost.kodeme.io
MATTERMOST_BOT_TOKEN=CHANGE_ME
MATTERMOST_TEAM_ID=CHANGE_ME
MCP_MATTERMOST_URL=
MCP_MATTERMOST_AUTH_TOKEN=

# Mailcow — REST API key from mailcow.kodeme.io → Configuration → API.
MAILCOW_BASE_URL=https://mailcow.kodeme.io
MAILCOW_API_KEY=CHANGE_ME
MAILCOW_API_KEY_TYPE=rw
MCP_MAILCOW_URL=
MCP_MAILCOW_AUTH_TOKEN=

# N8N — no kod-infra-n8n exists yet; tpp-infra-n8n is the available target.
N8N_BASE_URL=https://tpp-n8n.idtpp.com
N8N_API_KEY=CHANGE_ME
MCP_N8N_URL=
MCP_N8N_AUTH_TOKEN=

# WAHA — reuses the existing kod-infra-waha credentials. HMAC key lets a
# future inbound adapter verify webhook signatures.
WAHA_BASE_URL=https://waha.kodeme.io
WAHA_API_KEY=CHANGE_ME              # equals WAHA_API_KEY in .env.kod-infra-waha
WAHA_HMAC_KEY=CHANGE_ME             # equals WHATSAPP_HOOK_HMAC_KEY in .env.kod-infra-waha
MCP_WAHA_URL=
MCP_WAHA_AUTH_TOKEN=
