# Filestore backup for Pakerti (erp)
# RESTIC_PASSWORD is in 1Password: 'restic: tpp-odoo-filestore-backup'.
# Losing it makes every snapshot permanently unreadable — there is no
# recovery path. It must exist off this host BEFORE the first snapshot.
RESTIC_PASSWORD=CHANGEME
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
