# =============================================================================
# Pakerti Accurate-Sync — Production Environment (EXAMPLE)
# =============================================================================
# Committed reference. The real file is .env.tpp-accurate-sync (gitignored)
# and is normally written by `python deploys/generate.py --tenant tpp`, which
# mirrors PGHOST/PGPASSWORD/ODOO_ADMIN_PASSWD from the sibling .env.tpp-odoo-erp.
#
# Use this file directly only when:
#   - You are bootstrapping in the Dokploy UI without running the generator.
#   - You need to hand-craft a copy for staging / a spike environment.
#
# Replace every CHANGE_ME with the value from .env.tpp-odoo-erp in the same
# environment. Do NOT commit a populated copy — the .env.* pattern in
# deploys/.gitignore keeps secrets out of git.
# =============================================================================

# COMPOSE / TENANT METADATA
COMPOSE_PROJECT_NAME=tpp-accurate-sync   # Docker compose project name
TENANT=tpp                                 # Tenant slug (informational)

# DATABASE — must mirror .env.tpp-odoo-erp
PGHOST=10.0.0.2                            # Postgres host (private IP of tpp-prod-01)
PGPORT=5432                                # Postgres port
PGUSER=odoo                                # Odoo DB owner, has INSERT/UPDATE by default
PGPASSWORD=CHANGE_ME                       # From .env.tpp-odoo-erp (SECRET)
PGDATABASE=tpp_odoo_erp                    # Target Odoo database name

# ODOO — URL of the sibling Odoo instance, admin password for RPC calls
ODOO_URL=https://tpp-odoo-erp.idtpp.com    # Used for action_post_draft_moves JSON-RPC
ODOO_DB_FILTER=^tpp_odoo_erp$              # X-Odoo-dbfilter header regex
ODOO_ADMIN_PASSWD=CHANGE_ME                # From .env.tpp-odoo-erp (SECRET)

# TENANT LIST — comma-separated slugs from accurate_company.slug
ACCURATE_TENANTS=tpp

# IMAGE
IMAGE_TAG=latest                           # ghcr.io/tgunawandev/kodemeio-accurate-sync:<tag>
TZ=Asia/Jakarta
