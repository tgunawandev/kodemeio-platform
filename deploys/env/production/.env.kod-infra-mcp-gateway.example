# kod-infra-mcp-gateway — sanitized contract. Real secrets live in the
# gitignored sibling .env.kod-infra-mcp-gateway (operator-managed).

# Connection auth — consumers send `Authorization: Bearer <token>`.
# Generate: openssl rand -hex 32
MCP_GATEWAY_AUTH_TOKEN=change-me-long-random
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=8080
MCP_GATEWAY_LOG_LEVEL=info

# Backends proxied behind the gateway. Tools surface namespaced as <name>_<tool>.
# odoo = the curated community server (kod-infra-mcp-odoo, alias kod-mcp-odoo:8000).
# Add other backends (e.g. an n8n MCP Server Trigger URL) here later if needed.
MCP_BACKENDS={"odoo":{"url":"http://kod-mcp-odoo:8000/mcp","transport":"http"}}
