{
  "dashboard": {
    "uid": "kodemeio-dokploy-overview",
    "title": "Kodemeio Platform Overview",
    "description": "Service health, response times, PostgreSQL stats, and backup status for the Kodemeio platform",
    "tags": ["kodemeio", "platform", "overview"],
    "timezone": "Asia/Jakarta",
    "schemaVersion": 39,
    "version": 2,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "fiscalYearStartMonth": 0,
    "liveNow": false,
    "editable": true,
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {
            "selected": true,
            "text": "Prometheus",
            "value": "prometheus"
          },
          "hide": 0,
          "includeAll": false,
          "multi": false
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Service Health Grid",
        "description": "Current health status of all monitored services",
        "type": "state-timeline",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "red", "value": 0 },
                { "color": "green", "value": 1 }
              ]
            },
            "mappings": [
              { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
              { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" }
            ]
          },
          "overrides": []
        },
        "options": {
          "showValue": "auto",
          "mergeValues": true,
          "alignValue": "left",
          "rowHeight": 0.8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "probe_success{job=~\"blackbox-.*\"}",
            "legendFormat": "{{ instance }}",
            "instant": false,
            "range": true,
            "intervalMs": 60000
          }
        ]
      },
      {
        "id": 2,
        "title": "Service Status Summary",
        "description": "Current UP/DOWN count across all services",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "none"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "count(probe_success{job=~\"blackbox-.*\"} == 1)",
            "legendFormat": "Services UP"
          },
          {
            "refId": "B",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "count(probe_success{job=~\"blackbox-.*\"} == 0)",
            "legendFormat": "Services DOWN"
          }
        ]
      },
      {
        "id": 3,
        "title": "Average Uptime (7d)",
        "description": "Average probe success rate over the past 7 days",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 95 },
                { "color": "yellow", "value": 99 },
                { "color": "green", "value": 99.5 }
              ]
            },
            "unit": "percent",
            "min": 90,
            "max": 100
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "avg(avg_over_time(probe_success{job=~\"blackbox-.*\"}[7d])) * 100",
            "legendFormat": "Uptime %"
          }
        ]
      },
      {
        "id": 4,
        "title": "Active Alerts",
        "description": "Number of currently firing alerts",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 3 }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "none"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "count(ALERTS{alertstate=\"firing\"})",
            "legendFormat": "Firing"
          }
        ]
      },
      {
        "id": 5,
        "title": "SSL Cert Expiry (days)",
        "description": "Days until SSL certificate expires (minimum across all probes)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 7 },
                { "color": "yellow", "value": 14 },
                { "color": "green", "value": 30 }
              ]
            },
            "unit": "short",
            "decimals": 0
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "none"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "min((probe_ssl_earliest_cert_expiry - time()) / 86400)",
            "legendFormat": "Min SSL Expiry"
          }
        ]
      },
      {
        "id": 10,
        "title": "Response Time — Odoo Instances",
        "description": "HTTP probe duration for all Odoo /web/health endpoints",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "showPoints": "auto",
              "pointSize": 5,
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "scaleDistribution": { "type": "linear" }
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 2 },
                { "color": "red", "value": 5 }
              ]
            },
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "probe_duration_seconds{job=\"blackbox-odoo\"}",
            "legendFormat": "{{ instance }}"
          }
        ]
      },
      {
        "id": 11,
        "title": "Response Time — Infrastructure",
        "description": "HTTP probe duration for Authentik, Grafana, GlitchTip, Mailcow",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "showPoints": "auto",
              "pointSize": 5,
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "scaleDistribution": { "type": "linear" }
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 3 }
              ]
            },
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "probe_duration_seconds{job=\"blackbox-infra\"}",
            "legendFormat": "{{ instance }}"
          }
        ]
      },
      {
        "id": 12,
        "title": "Response Time — Websites",
        "description": "HTTP probe duration for Next.js websites",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "showPoints": "auto",
              "pointSize": 5,
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "scaleDistribution": { "type": "linear" }
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 2 },
                { "color": "red", "value": 5 }
              ]
            },
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "probe_duration_seconds{job=\"blackbox-websites\"}",
            "legendFormat": "{{ instance }}"
          }
        ]
      },
      {
        "id": 20,
        "title": "PostgreSQL — Active Connections",
        "description": "Current active connections vs max_connections",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 15,
              "gradientMode": "scheme",
              "showPoints": "never",
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "scaleDistribution": { "type": "linear" },
              "thresholdsStyle": { "mode": "dashed" }
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 80 },
                { "color": "red", "value": 160 }
              ]
            },
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Max Connections" },
              "properties": [
                { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
                { "id": "custom.fillOpacity", "value": 0 }
              ]
            }
          ]
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "pg_stat_activity_count{instance=~\".*:9187\"}",
            "legendFormat": "Active ({{ datname }})"
          },
          {
            "refId": "B",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "pg_settings_max_connections{instance=~\".*:9187\"}",
            "legendFormat": "Max Connections"
          }
        ]
      },
      {
        "id": 21,
        "title": "PostgreSQL — Connection by State",
        "description": "Breakdown of connections by state (active, idle, idle in transaction)",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "pieType": "donut",
          "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
          "tooltip": { "mode": "single" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "sum by (state) (pg_stat_activity_count{instance=~\".*:9187\"})",
            "legendFormat": "{{ state }}"
          }
        ]
      },
      {
        "id": 22,
        "title": "PostgreSQL — Database Size",
        "description": "Size of each PostgreSQL database",
        "type": "bargauge",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 5368709120 },
                { "color": "red", "value": 10737418240 }
              ]
            },
            "unit": "bytes"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "pg_database_size_bytes{datname!~\"template.*|postgres\"}",
            "legendFormat": "{{ datname }}"
          }
        ]
      },
      {
        "id": 30,
        "title": "Backup Age (hours since last success)",
        "description": "Hours since the last successful backup per job. Threshold: 26h = missed daily backup.",
        "type": "bargauge",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 24 },
                { "color": "red", "value": 26 }
              ]
            },
            "unit": "h",
            "decimals": 1
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "minVizHeight": 20
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "(time() - backup_last_success_timestamp_seconds) / 3600",
            "legendFormat": "{{ job }}"
          }
        ]
      },
      {
        "id": 40,
        "title": "Disk Usage",
        "description": "Filesystem usage percentage across all nodes",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 75 },
                { "color": "red", "value": 85 }
              ]
            },
            "unit": "percent",
            "decimals": 1,
            "custom": {
              "align": "auto",
              "cellOptions": { "type": "color-background" }
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Total" },
              "properties": [{ "id": "unit", "value": "bytes" }]
            },
            {
              "matcher": { "id": "byName", "options": "Available" },
              "properties": [{ "id": "unit", "value": "bytes" }]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [{ "displayName": "Usage %", "desc": true }],
          "footer": { "show": false }
        },
        "transformations": [
          {
            "id": "merge",
            "options": {}
          }
        ],
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "(1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",mountpoint!~\"/boot.*\"}) * 100",
            "legendFormat": "{{ instance }} {{ mountpoint }}",
            "instant": true,
            "format": "table"
          }
        ]
      },
      {
        "id": 41,
        "title": "Container Memory Usage (Top 10)",
        "description": "Memory usage of the top 10 containers by consumption",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "scheme",
              "showPoints": "never",
              "stacking": { "mode": "none" },
              "axisCenteredZero": false,
              "scaleDistribution": { "type": "linear" }
            },
            "unit": "bytes"
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "topk(10, container_memory_usage_bytes{name!=\"\"})",
            "legendFormat": "{{ name }}"
          }
        ]
      }
    ]
  },
  "overwrite": true,
  "message": "Applied from monitoring-as-code"
}
