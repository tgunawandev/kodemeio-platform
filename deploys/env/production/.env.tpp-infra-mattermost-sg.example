# =============================================================================
# Mattermost Team Chat - TPP SINGAPORE LATENCY TEST (tpp-prod-06)
# =============================================================================
# Isolated test instance. NOT a production replica:
#   - Fresh embedded PostgreSQL (own volume, no shared data with mm.idtpp.com)
#   - LOCAL file storage (NOT the Germany S3 bucket — that would re-create the
#     trans-continental latency this test exists to eliminate)
#   - Dedicated Authentik OAuth app (prod Mattermost app left untouched)
# Copy to .env.tpp-infra-mattermost-sg and fill real values.
# =============================================================================

# --- Compose ---
COMPOSE_PROJECT_NAME=tpp-infra-mattermost-sg
TENANT=tpp
MM_DOMAIN=sg-mm.idtpp.com

# --- Deployment Identity ---
DEPLOY_ENV=production
DEPLOY_NAME=tpp-mattermost-sg

# --- Dokploy ---
DOKPLOY_PROJECT_NAME=tpp-infra-mattermost-sg
DOKPLOY_GITHUB_OWNER=tgunawandev
DOKPLOY_GITHUB_REPO=kodemeio-mattermost
DOKPLOY_GITHUB_BRANCH=main
DOKPLOY_COMPOSE_FILE=docker-compose.prod.yml
USE_ALL_ENV=true

# --- Mattermost Version ---
MM_IMAGE_TAG=10.5

# --- PostgreSQL (internal dedicated container, fresh volume) ---
# Generate: openssl rand -base64 32
MM_POSTGRESQL_USER=mmuser
MM_POSTGRESQL_PASSWORD=__GENERATE_ME__
MM_POSTGRESQL_NAME=mattermost

# --- Authentik SSO (dedicated app for sg-mm; create via kctl-ak) ---
AUTHENTIK_URL=https://auth.idtpp.com
AUTHENTIK_MATTERMOST_CLIENT_ID=__SG_CLIENT_ID__
AUTHENTIK_MATTERMOST_CLIENT_SECRET=__SG_CLIENT_SECRET__

# --- File Storage: LOCAL DISK on the SG box (the whole point of the test) ---
MM_FILESETTINGS_DRIVERNAME=local
MM_FILESETTINGS_MAXFILESIZE=256000000
# S3 file vars intentionally left empty (driver is local)
MM_FILESETTINGS_AMAZONS3ACCESSKEYID=
MM_FILESETTINGS_AMAZONS3SECRETACCESSKEY=
MM_FILESETTINGS_AMAZONS3BUCKET=
MM_FILESETTINGS_AMAZONS3ENDPOINT=
MM_FILESETTINGS_AMAZONS3REGION=
MM_FILESETTINGS_AMAZONS3SSL=true
MM_FILESETTINGS_AMAZONS3SIGNV2=false

# --- Email (reuse TPP Mailcow; additive, harmless) ---
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=true
MM_EMAILSETTINGS_ENABLESMTPAUTH=true
MM_EMAILSETTINGS_SMTPSERVER=mail.idtpp.com
MM_EMAILSETTINGS_SMTPPORT=587
MM_EMAILSETTINGS_SMTPUSERNAME=noreply-mattermost@idtpp.com
MM_EMAILSETTINGS_SMTPPASSWORD=__MAILCOW_PASSWORD__
MM_EMAILSETTINGS_CONNECTIONSECURITY=STARTTLS
MM_EMAILSETTINGS_FEEDBACKEMAIL=noreply-mattermost@idtpp.com
MM_EMAILSETTINGS_FEEDBACKNAME=Mattermost SG Test
MM_EMAILSETTINGS_REPLYTOADDRESS=noreply-mattermost@idtpp.com

# --- Feature Settings ---
MM_PLUGINSETTINGS_ENABLEUPLOADS=true
MM_SERVICESETTINGS_ENABLEOPENSERVER=false
MM_TEAMSETTINGS_MAXUSERSPERTEAM=1000
MM_EMAILSETTINGS_ENABLEPREVIEWMODEBANNER=false
MM_EMAILSETTINGS_ENABLESIGNUPWITHEMAIL=false
MM_EMAILSETTINGS_ENABLESIGNINWITHEMAIL=true

# --- S3 Backup (separate test bucket; OPTIONAL — test has no precious data) ---
S3_BACKUP_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BACKUP_ACCESS_KEY=__S3_BACKUP_KEY__
S3_BACKUP_SECRET_KEY=__S3_BACKUP_SECRET__
S3_BACKUP_BUCKET=hz-tpp-mm-sg-backup
S3_BACKUP_REGION=fsn1
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4

# --- Resource Limits (CPX32: 4 vCPU / 8 GB) ---
CPU_LIMIT_MM=2
MEMORY_LIMIT_MM=3G
CPU_LIMIT_DB=1
MEMORY_LIMIT_DB=1G
CPU_LIMIT_BACKUP=0.25
MEMORY_LIMIT_BACKUP=128M

# --- Timezone ---
TZ=Asia/Jakarta
