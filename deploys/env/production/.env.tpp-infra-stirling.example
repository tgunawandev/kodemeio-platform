# =============================================================================
# tpp-infra-stirling — TPP PRODUCTION (sanitized template)
# =============================================================================
# Stirling PDF — self-hosted PDF toolkit (60+ tools, OCR, LibreOffice, REST API).
# SSO is enforced by the Traefik forward-auth middleware defined IN the upstream
# repo's docker-compose.prod.yml.
#
# Copy to .env.tpp-infra-stirling (drop the .example suffix), fill real secrets,
# then `generate.py` runs the deploy pipeline.

# =============================================================================
# Compose
# =============================================================================
COMPOSE_PROJECT_NAME=tpp-infra-stirling
TENANT=tpp

# =============================================================================
# Domain
# =============================================================================
DOMAIN=stirling.idtpp.com

# =============================================================================
# Image — pin to a specific tag/digest for production
# =============================================================================
STIRLING_IMAGE=stirlingtools/stirling-pdf
STIRLING_TAG=latest-fat

# =============================================================================
# Security & Authentication (internal Stirling login)
# =============================================================================
SECURITY_ENABLELOGIN=true
SECURITY_INITIALLOGIN_USERNAME=admin
SECURITY_INITIALLOGIN_PASSWORD=change-me-strong-password
SECURITY_CSRFDISABLED=false

# Global API Key — generate with: openssl rand -hex 32 (prefix with sk-stirling-).
SECURITY_CUSTOMGLOBALAPIKEY=sk-stirling-change-me-64-hex-chars

# =============================================================================
# Java / JVM Settings
# =============================================================================
JAVA_MIN_HEAP=512m
JAVA_MAX_HEAP=4g

# =============================================================================
# System Configuration
# =============================================================================
SYSTEM_MAXFILESIZE=200
SYSTEM_DEFAULTLOCALE=en_US

# CORS — comma-separated origins (NEVER use * in production).
SYSTEM_CORSALLOWEDORIGINS=https://stirling.idtpp.com

# =============================================================================
# OCR & Advanced Conversions
# =============================================================================
INSTALL_BOOK_AND_ADVANCED_HTML_OPS=true

# =============================================================================
# Authentik OAuth2 SSO (native, single login)
# =============================================================================
# Stirling uses its built-in OAuth2 client. Create an OAuth2 (confidential)
# provider in Authentik with redirect_uri
#   https://stirling.idtpp.com/login/oauth2/code/oidc
# bind it to an Application, copy client_id/client_secret here.
SECURITY_OAUTH2_ENABLED=true
SECURITY_OAUTH2_AUTOCREATEUSER=true
SECURITY_OAUTH2_BLOCKREGISTRATION=false
SECURITY_OAUTH2_USEASUSERNAME=email
SECURITY_OAUTH2_PROVIDER=keycloak
SECURITY_OAUTH2_CLIENT_ID=change-me-from-authentik
SECURITY_OAUTH2_CLIENT_SECRET=change-me-from-authentik
SECURITY_OAUTH2_ISSUER=https://auth.idtpp.com/application/o/stirling-pdf/
SECURITY_OAUTH2_SCOPES=openid,profile,email

# =============================================================================
# Resource Limits
# =============================================================================
CPU_LIMIT=2
MEMORY_LIMIT=4G

# =============================================================================
# Logging
# =============================================================================
LOG_MAX_SIZE=50m
LOG_MAX_FILE=3

# =============================================================================
# Timezone
# =============================================================================
TZ=Asia/Jakarta
