# kodemeio-authentik — Production (kod) [server: kod-prod-03-data] — EMBEDDED Postgres
# Copy to .env.kod-infra-authentik (gitignored) and fill secrets.
COMPOSE_PROJECT_NAME=kod-infra-authentik
TENANT=kodemeio
DOMAIN=auth.kodeme.io
AUTHENTIK_TAG=2026.2.3
AUTHENTIK_DEBUG=false
TZ=Asia/Jakarta

# bootstrap (first run; akadmin login = this email + password)
AUTHENTIK_BOOTSTRAP_EMAIL=admin@kodeme.io
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME            # openssl rand -hex 16
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME               # openssl rand -hex 32

# security
AUTHENTIK_SECRET_KEY=CHANGE_ME                    # openssl rand -base64 60
ERROR_REPORTING=false

# embedded postgres
AUTHENTIK_POSTGRESQL_USER=authentik
AUTHENTIK_POSTGRESQL_NAME=authentik
AUTHENTIK_POSTGRESQL_PASSWORD=CHANGE_ME           # openssl rand -hex 24

# media on local volume (no S3)
AUTHENTIK_STORAGE_BACKEND=file
