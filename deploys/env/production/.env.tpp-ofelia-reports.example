# Ofelia scheduler (reports) for Pakerti
SCHEDULE_FILE=tpp-reports.ini
CONTAINER_NAME=tpp-ofelia-reports
KODEMEIO_CONFIG_HOST=/opt/kodemeio/config.yaml
TZ=Asia/Jakarta
OFELIA_TAG=latest

# --- Trade sales report SMTP sender (set REAL values in Dokploy app env, do NOT commit) ---
# Proven working idtpp sender: noreply-glpi@idtpp.com (auths on mail.idtpp.com:587)
TRADE_REPORT_SMTP_USER=noreply-glpi@idtpp.com
TRADE_REPORT_SMTP_PASS=__SET_IN_DOKPLOY__
