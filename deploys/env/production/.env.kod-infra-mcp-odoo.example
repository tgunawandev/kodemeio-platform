# kod-infra-mcp-odoo — community Odoo MCP (tuanle96/mcp-odoo) service account.
# Sanitized; real secrets live in the gitignored .env.kod-infra-mcp-odoo.

ODOO_URL=https://your-odoo.example.com
ODOO_DB=your_db
ODOO_USERNAME=mcp_service_account
ODOO_API_KEY=change-me
# ODOO_PASSWORD=change-me
ODOO_TRANSPORT=xmlrpc

MCP_ALLOW_REMOTE_HTTP=1
MCP_ALLOWED_HOSTS=kod-mcp-odoo
ODOO_MCP_ENABLE_WRITES=0
ODOO_MCP_LOG_LEVEL=info
