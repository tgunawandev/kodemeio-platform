# =============================================================================
# n8n Workflow Automation — TPP (Pakerti) PRODUCTION — EXAMPLE
# Service: tpp-infra-n8n | Server: tpp-prod-01 | Domain: n8n.idtpp.com
# =============================================================================
# Copy to .env.tpp-infra-n8n and fill in the CHANGEME-* placeholders.
# Sanitized template — safe to commit.
# =============================================================================

# =============================================================================
# COMPOSE
# =============================================================================
COMPOSE_PROJECT_NAME=tpp-infra-n8n
TZ=Asia/Jakarta

# =============================================================================
# n8n — Core
# =============================================================================
N8N_HOST=n8n.idtpp.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.idtpp.com/

# Generate fresh for production — do NOT reuse the dev key.
# python3 -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=CHANGEME-N8N-ENCRYPTION-KEY

# =============================================================================
# DATABASE — tpp-infra-postgres (Hetzner private network 10.0.0.2)
# Provision: kctl-pg db create n8n --owner n8n --password <pw>
# =============================================================================
DB_POSTGRESDB_HOST=10.0.0.2
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=CHANGEME-DB-PASSWORD
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# =============================================================================
# EXECUTION & PERFORMANCE
# =============================================================================
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_CONCURRENCY_PRODUCTION_LIMIT=20

# =============================================================================
# LOGGING
# =============================================================================
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
